# Top Left                  Green
v -0.5 0.0 -0.5         0.247 0.608 0.043

# Top Right                 Green
v  0.5 0.0 -0.5         0.247 0.608 0.043

# Bottom Left               Green
v -0.5 0.0 0.5         0.247 0.608 0.043

# Bottom Right              Green
v  0.5 0.0 0.5         0.247 0.608 0.043
